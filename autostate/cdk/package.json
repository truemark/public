    "cdk": "cdk",
    "fmt": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "aws-cdk": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "autostate-handlers": "workspace:"
  },
  "dependencies": {
    "aws-cdk-lib": "catalog:",
    "constructs": "catalog:",
    "source-map-support": "catalog:",
    "truemark-cdk-lib": "workspace:"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
