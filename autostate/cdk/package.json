{
  "name": "autostate-cdk",
  "version": "1.2.1",
  "private": true,
  "description": "An AWS CDK project that automatically starts, stops, reboots and terminates resources through tags.",
  "homepage": "https://github.com/truemark/public/tree/main/autostate",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git@github.com:truemark/public.git"
  },
  "bin": {
    "autostate": "bin/autostate.js"
  },
  "scripts": {
    "prebuild": "prettier --check . && eslint .",
    "build": "tsc",
    "watch": "tsc -w",
