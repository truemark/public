{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push -u origin HEAD)",
      "Bash(git switch:*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git stash:*)",
      "Bash(gh pr:*)",
      "Bash(gh api:*)",
      "Bash(gh repo view:*)",
      "Bash(gh auth status:*)",
      "Bash(jq:*)",
      "Bash(date:*)",
      "Bash(sleep:*)",
      "Bash(wc:*)",
      "Bash(tr:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh api -X:*)",
      "Bash(gh api --method:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo delete:*)"
    ]
  }
}
